MP_API_KEY=your_materials_project_api_key

# Cognee embeddings: BGE-M3 (PRD), served locally by Ollama - no API key.
#   ollama serve && ollama pull bge-m3
# Previous Phase 1 setting (kept for the embedding ablation):
#   EMBEDDING_PROVIDER=fastembed / EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 / EMBEDDING_DIMENSIONS=384
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
HUGGINGFACE_TOKENIZER=BAAI/bge-m3
# Ollama embeds one request at a time; cognee runs 4 batches concurrently, so
# keep batches small or long robocrys descriptions queue past cognee's 60 s timeout.
EMBEDDING_BATCH_SIZE=8

# Graph DB (embedded, file-based - no infra needed)
GRAPH_DATABASE_PROVIDER=kuzu
VECTOR_DB_PROVIDER=lancedb
DB_PROVIDER=sqlite

# Phase 2 LLM: OpenRouter (OpenAI-compatible). Models are LiteLLM ids.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/qwen/qwen3.8-27b:free
# Comma-separated, tried in order when the primary is rate-limited/unavailable.
OPENROUTER_FALLBACK_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/google/gemma-4-31b-it:free

# Skips cognee's one-time LLM connectivity self-test at pipeline startup.
# (The build path makes no LLM calls; Phase 2's LLM calls go through
# matgraph.llm, not cognee's LLM config.)
COGNEE_SKIP_CONNECTION_TEST=true
